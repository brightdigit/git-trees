#!/usr/bin/env bash
# git-trees — bare repo + worktree management
#
# Install: place on PATH as `git-trees`, chmod +x, then use `git trees <cmd>`.
#
#   git trees init <org/repo|repo|url> [--host h] [--dir d]
#   git trees root [dir]               print project root; link .git if missing
#   git trees add <branch> [base] [--print-path]
#   git trees track [path]
#   git trees list [--json]            (alias: ls)
#   git trees clean [--older-than N] [--merged|--gone] [--apply]
#
# Env (all optional):
#   TREES_HOST             default host for init (default: github.com)
#   TREES_ORG              default org; if unset, bare repo names are rejected
#   TREES_AGENTS_TEMPLATE  AGENTS.md copied into each new worktree

set -uo pipefail

: "${TREES_HOST:=}"
: "${TREES_ORG:=}"
: "${TREES_AGENTS_TEMPLATE:=$HOME/.config/git-trees/AGENTS.md}"

# --- internals ---------------------------------------------------------------

_root() {
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  cd "$(dirname "$common")" 2>/dev/null && pwd
}

_path_for() {   # _path_for <branch> -> worktree path or empty
  git worktree list --porcelain \
    | awk -v b="refs/heads/$1" '/^worktree /{p=$2} $0=="branch "b{print p}'
}

# Absolute path -> path relative to $1; unchanged if outside.
_rel_to() {
  case "$2" in
    "$1") echo . ;;
    "$1"/*) echo "${2#"$1"/}" ;;
    *) echo "$2" ;;
  esac
}

_default_branch() {
  local d c
  d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
  [ -n "$d" ] && { echo "$d"; return 0; }
  for c in main master; do
    git show-ref --verify --quiet "refs/remotes/origin/$c" && { echo "$c"; return 0; }
  done
  echo main
}

_ref_info() {   # _ref_info <branch> -> upstream|track|date
  git for-each-ref --format='%(upstream:short)|%(upstream:track)|%(committerdate:short)' \
    "refs/heads/$1"
}

_is_bare_dir() {
  local p="$1"
  [ -f "$p/HEAD" ] && [ -d "$p/refs" ] && [ -d "$p/objects" ] && [ ! -e "$p/.git" ] || return 1
  [ "$(git -C "$p" config --bool --get core.bare 2>/dev/null)" = "true" ]
}

# Print basename of the sole bare *.git under $1, or error.
_find_bare() {
  local dir="$1" found="" name
  for name in "$dir"/*.git; do
    [ -d "$name" ] || continue
    _is_bare_dir "$name" || continue
    if [ -n "$found" ]; then
      echo "git trees root: multiple bare repos in $dir — leave one *.git" >&2
      return 1
    fi
    found=${name##*/}
  done
  [ -n "$found" ] || {
    echo "git trees root: no bare *.git in $dir" >&2
    return 1
  }
  echo "$found"
}

# Write $1/.git -> ./<bare>.git when missing. Idempotent if already valid.
_ensure_git_pointer() {
  local root="$1" bare
  if [ -e "$root/.git" ]; then
    if [ -d "$root/.git" ]; then
      echo "git trees root: $root/.git is a directory (regular clone, not a trees root)" >&2
      return 1
    fi
    if ! git -C "$root" rev-parse --git-common-dir >/dev/null 2>&1; then
      echo "git trees root: $root/.git exists but is not a valid gitdir pointer" >&2
      return 1
    fi
    return 0
  fi
  bare=$(_find_bare "$root") || return 1
  echo "gitdir: ./$bare" > "$root/.git"
  echo "linked ./$bare" >&2
}

# --- init --------------------------------------------------------------------

# Last path segment of a clone URL → default directory name.
_url_basename() {
  local s="$1"
  s=${s%/}
  s=${s%.git}
  s=${s##*/}
  s=${s##*:}   # git@host:repo (no slash)
  echo "$s"
}

cmd_init() {
  local host="" arg="" dir="" repo url="" host_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="${2:-}"; host_set=1; shift 2 ;;
      --dir)  dir="${2:-}";  shift 2 ;;
      -*)     echo "git trees init: unknown option $1" >&2; return 1 ;;
      *)      arg="$1";      shift ;;
    esac
  done

  [ -z "$arg" ] && {
    echo "usage: git trees init <org/repo|repo|url> [--host h] [--dir d]" >&2
    return 1
  }

  case "$arg" in
    git@*|ssh://*|https://*|http://*|file://*)
      url=$arg
      : "${dir:=$(_url_basename "$url")}"
      [ "$host_set" -eq 1 ] &&
        echo "git trees init: --host ignored when a URL is given" >&2
      ;;
    */*)
      repo=$arg
      : "${host:=${TREES_HOST:-github.com}}"
      : "${dir:=${repo##*/}}"
      url="https://$host/$repo.git"
      ;;
    *)
      [ -z "$TREES_ORG" ] && {
        echo "git trees init: '$arg' has no org and TREES_ORG is unset — pass <org/repo> or a URL" >&2
        return 1
      }
      repo="$TREES_ORG/$arg"
      : "${host:=${TREES_HOST:-github.com}}"
      : "${dir:=$arg}"
      url="https://$host/$repo.git"
      ;;
  esac

  [ -z "$dir" ] && {
    echo "git trees init: could not derive directory name from '$arg' — pass --dir" >&2
    return 1
  }

  [ -e "$dir" ] && { echo "git trees init: $dir already exists" >&2; return 1; }

  mkdir -p "$dir" || return 1
  if ! git clone --bare "$url" "$dir/trees-bare.git"; then
    rm -rf "$dir"
    return 1
  fi

  # Pointer so plain git works from the container root; bare store stays visible.
  echo "gitdir: ./trees-bare.git" > "$dir/.git"
  git -C "$dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git -C "$dir" fetch origin
  git -C "$dir" remote set-head origin --auto >/dev/null 2>&1

  [ -f "$TREES_AGENTS_TEMPLATE" ] && cp "$TREES_AGENTS_TEMPLATE" "$dir/AGENTS.md"

  local def
  def=$(cd "$dir" && _default_branch)
  echo "initialized $dir (default branch: $def)"
}

# --- root --------------------------------------------------------------------

cmd_root() {
  local dir="${1:-.}" root

  [ $# -gt 1 ] && {
    echo "usage: git trees root [dir]" >&2
    return 1
  }
  [ -d "$dir" ] || {
    echo "git trees root: not a directory: $dir" >&2
    return 1
  }
  dir=$(cd "$dir" && pwd)

  # Prefer a local bare *.git (grove / trees container) over walking up into a
  # parent git repo — otherwise `root` inside a nested fixture finds the wrong top.
  local name has_bare=0
  for name in "$dir"/*.git; do
    [ -d "$name" ] && _is_bare_dir "$name" && { has_bare=1; break; }
  done
  if [ "$has_bare" -eq 1 ]; then
    _ensure_git_pointer "$dir" || return 1
    echo "$dir"
    return 0
  fi

  # Inside a worktree: discover the shared container, then ensure its pointer.
  if root=$(cd "$dir" && _root 2>/dev/null); then
    _ensure_git_pointer "$root" || return 1
    echo "$root"
    return 0
  fi

  echo "git trees root: not a trees project (no bare *.git, not a worktree)" >&2
  return 1
}

# --- add ---------------------------------------------------------------------

cmd_add() {
  local br="" base="" print_path=0 root path dir

  while [ $# -gt 0 ]; do
    case "$1" in
      --print-path) print_path=1; shift ;;
      -*) echo "git trees add: unknown option $1" >&2; return 1 ;;
      *)
        if [ -z "$br" ]; then br="$1"
        elif [ -z "$base" ]; then base="$1"
        else echo "git trees add: unexpected argument $1" >&2; return 1
        fi
        shift ;;
    esac
  done

  [ -z "$br" ] && { echo "usage: git trees add <branch> [base] [--print-path]" >&2; return 1; }

  case "$br" in
    */*)
      echo "git trees add: branch names must not contain '/'; use dashes (e.g. feature-x), not feature/x" >&2
      return 1
      ;;
  esac

  root=$(_root) || { echo "git trees add: not in a git repo" >&2; return 1; }

  path=$(_path_for "$br")
  if [ -n "$path" ]; then
    if [ "$print_path" -eq 1 ]; then echo "$path"; else
      echo "git trees add: worktree already exists at $path" >&2
    fi
    return 0
  fi

  dir="$root/$br"
  if [ -e "$dir" ]; then
    echo "git trees add: directory already exists: $dir" >&2
    return 1
  fi

  if git show-ref --verify --quiet "refs/heads/$br"; then
    [ -n "$base" ] && echo "git trees add: $br exists — ignoring base '$base'" >&2
    git worktree add "$dir" "$br" >&2 || return 1
  elif git ls-remote --exit-code --heads origin "$br" >/dev/null 2>&1; then
    [ -n "$base" ] && echo "git trees add: origin/$br exists — ignoring base '$base'" >&2
    git fetch origin "$br" >&2 || return 1
    git worktree add --track -b "$br" "$dir" "origin/$br" >&2 || return 1
  else
    : "${base:=origin/$(_default_branch)}"
    # --no-track: a new branch must not inherit the base ref's upstream,
    # or it would silently push to the base branch.
    git worktree add --no-track -b "$br" "$dir" "$base" >&2 || return 1
  fi

  cmd_track "$dir" >&2 || return 1

  [ -f "$TREES_AGENTS_TEMPLATE" ] && [ ! -f "$dir/AGENTS.md" ] \
    && cp "$TREES_AGENTS_TEMPLATE" "$dir/AGENTS.md"

  if [ "$print_path" -eq 1 ]; then
    echo "$dir"
  else
    echo "$dir" >&2
  fi
}

# --- track -------------------------------------------------------------------

cmd_track() {
  local path="${1:-.}" br
  br=$(git -C "$path" symbolic-ref --short HEAD 2>/dev/null) || {
    echo "git trees track: detached HEAD or not a worktree: $path" >&2
    return 1
  }

  if git -C "$path" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    return 0
  fi

  if git -C "$path" ls-remote --exit-code --heads origin "$br" >/dev/null 2>&1; then
    git -C "$path" fetch origin "$br" \
      && git -C "$path" branch --set-upstream-to="origin/$br" "$br"
  else
    git -C "$path" push -u origin HEAD
  fi
}

# --- list --------------------------------------------------------------------

cmd_list() {
  local json=0 rows="" br path up track age dirty root rel

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) echo "git trees list: unknown option $1" >&2; return 1 ;;
    esac
  done

  root=$(_root) || { echo "git trees list: not in a git repo" >&2; return 1; }

  while IFS=$'\t' read -r br path; do
    IFS='|' read -r up track age <<< "$(_ref_info "$br")"
    dirty="clean"
    [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ] && dirty="dirty"
    rel=$(_rel_to "$root" "$path")
    rows+="$br"$'\t'"${up:--}"$'\t'"${track:--}"$'\t'"$age"$'\t'"$dirty"$'\t'"$rel"$'\n'
  done < <(
    git worktree list --porcelain \
      | awk '/^worktree /{p=$2} /^branch /{sub("refs/heads/","",$2); print $2"\t"p}'
  )

  while read -r br; do
    [ -n "$(_path_for "$br")" ] && continue
    IFS='|' read -r up track age <<< "$(_ref_info "$br")"
    rows+="$br"$'\t'"${up:--}"$'\t'"${track:--}"$'\t'"$age"$'\t'"-"$'\t'"(none)"$'\n'
  done < <(git for-each-ref --format='%(refname:short)' refs/heads)

  if [ "$json" -eq 1 ]; then
    printf '%s' "$rows" | awk -F'\t' '
      BEGIN { print "["; sep = "" }
      NF {
        for (i = 1; i <= NF; i++) gsub(/"/, "\\\"", $i)
        printf "%s  {\"branch\":\"%s\",\"upstream\":\"%s\",\"track\":\"%s\",\"date\":\"%s\",\"state\":\"%s\",\"path\":\"%s\"}\n", \
          sep, $1, $2, $3, $4, $5, $6
        sep = ","
      }
      END { print "]" }'
  else
    printf '%s' "$rows" | awk -F'\t' '
      NF {
        if (n++) print ""
        print $1
        print "  upstream  " $2
        print "  track     " $3
        print "  date      " $4
        print "  state     " $5
        print "  path      " $6
      }'
  fi
}

# --- clean -------------------------------------------------------------------

cmd_clean() {
  local days="" apply=0 do_gone=1 do_merged=1 do_stale=0 root def br p wt

  while [ $# -gt 0 ]; do
    case "$1" in
      --older-than) days="${2:-}"; do_stale=1; shift 2 ;;
      --gone)       do_gone=1; do_merged=0; shift ;;
      --merged)     do_merged=1; do_gone=0; shift ;;
      --apply)      apply=1; shift ;;
      *) echo "git trees clean: unknown option $1" >&2; return 1 ;;
    esac
  done

  root=$(_root) || { echo "git trees clean: not in a git repo" >&2; return 1; }
  def=$(_default_branch)
  git fetch --prune origin

  if [ "$do_gone" -eq 1 ]; then
    echo "== branches with gone upstream =="
    while read -r br; do
      [ -z "$br" ] && continue
      p=$(_path_for "$br")
      echo "  $br${p:+  ($p)}"
      if [ "$apply" -eq 1 ]; then
        [ -n "$p" ] && git worktree remove "$p"
        git branch -d "$br" 2>/dev/null \
          || echo "    ! unmerged — use: git branch -D $br"
      fi
    done < <(
      git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
        | grep '\[gone\]' | awk '{print $1}'
    )
  fi

  if [ "$do_merged" -eq 1 ]; then
    echo "== branches merged into $def =="
    while read -r br; do
      [ -z "$br" ] && continue
      # Skip branches that have no commits of their own — a branch pointing at
      # the base, or freshly created from it, is "merged" but not finished work.
      [ "$(git rev-list --count "origin/$def..$br" 2>/dev/null)" = "0" ] && continue
      p=$(_path_for "$br")
      echo "  $br${p:+  ($p)}"
      if [ "$apply" -eq 1 ]; then
        [ -n "$p" ] && git worktree remove "$p"
        git branch -d "$br"
      fi
    done < <(
      git branch --merged "origin/$def" --format='%(refname:short)' 2>/dev/null \
        | grep -vx "$def"
    )
  fi

  if [ "$do_stale" -eq 1 ]; then
    [ -z "$days" ] && { echo "git trees clean: --older-than needs a number of days" >&2; return 1; }
    local common
    common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
    echo "== worktrees untouched >${days}d =="
    while read -r wt; do
      [ "$wt" = "$root" ] && continue
      [ "$wt" = "$PWD" ] && continue
      [ "$wt" = "$common" ] && continue   # bare store (trees-bare.git), not a worktree
      if [ -n "$(find "$wt" -maxdepth 0 -mtime +"$days" 2>/dev/null)" ]; then
        echo "  $wt"
        [ "$apply" -eq 1 ] && git worktree remove "$wt"
      fi
    done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
  fi

  git worktree prune
  [ "$apply" -eq 0 ] && echo "(report only — pass --apply to execute)"
  return 0
}

# --- usage / dispatch --------------------------------------------------------

usage() {
  cat >&2 <<'EOF'
usage: git trees <command> [args]

  init <org/repo|repo|url> [--host h] [--dir d]   create bare repo + worktree layout
  root [dir]                                  print project root; link .git if missing
  add <branch> [base] [--print-path]          create a worktree (sets upstream)
  track [path]                                ensure branch has an upstream
  list [--json]                               worktrees + branches without one
  clean [--older-than N] [--merged|--gone] [--apply]
                                              report/remove stale trees, branches

env: TREES_HOST, TREES_ORG, TREES_AGENTS_TEMPLATE

note: `add` prints the worktree path but cannot cd your shell. For that:
  trees() {
    case "$1" in
      add) shift; cd "$(git trees add "$@" --print-path)" ;;
      *)   git trees "$@" ;;
    esac
  }
EOF
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift

  case "$cmd" in
    init)      cmd_init  "$@" ;;
    root)      cmd_root  "$@" ;;
    add)       cmd_add   "$@" ;;
    track)     cmd_track "$@" ;;
    list|ls)   cmd_list  "$@" ;;
    clean)     cmd_clean "$@" ;;
    help|--help|-h) usage; return 0 ;;
    *) echo "git trees: unknown command '$cmd'" >&2; usage; return 1 ;;
  esac
}

main "$@"
